# Google Gemini API Configuration (Backend only, never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Application Confidence Threshold (0.0 to 1.0)
# Plants with confidence >= threshold are marked 'identified'
# Plants with confidence < threshold are marked 'unclear'
CONFIDENCE_THRESHOLD=0.70

# MongoDB Configuration
# Optional: Connects to MongoDB Atlas or local MongoDB.
# If omitted or unavailable, backend automatically uses local plants.json catalog fallback.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=ayurscan

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated, or * to allow all origins in production)
CORS_ORIGINS=*
